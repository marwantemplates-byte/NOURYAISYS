{
  "name": "NOURYS + OmniRoute",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22",
  "forwardPorts": [20128],
  "portsAttributes": {
    "20128": { "label": "OmniRoute", "onAutoForward": "notify", "visibility": "private" }
  },
  "containerEnv": {
    "OMNIROUTE_SERVER_HOST": "127.0.0.1",
    "REQUIRE_API_KEY": "true"
  },
  "postCreateCommand": "npm install -g omniroute @anthropic-ai/claude-code"
}
